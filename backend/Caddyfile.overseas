# 海外新加坡机（易玩家付费 API）。DNS A → 本机公网 IP；勿 Cloudflare 橙云。
# compose 挂的是 ./Caddyfile，部署时必须：cp Caddyfile.overseas Caddyfile
# H2-only，勿开 HTTP/3 / Alt-Svc:h3（见 .cursor/rules/prod-tls-http3.mdc）
{
	servers {
		protocols h1 h2
	}
}

(api_proxy) {
	header -Alt-Svc
	encode gzip
	# 侧载 APK 等静态包；勿当 App Release API 基址
	handle /download {
		redir * /download/ 308
	}
	handle_path /download/* {
		root * /srv/download
		file_server
		header {
			X-Content-Type-Options nosniff
			Cache-Control "public, max-age=300"
		}
	}
	@admin {
		path /admin /admin/* /v1/admin /v1/admin/*
	}
	handle @admin {
		basic_auth {
			{env.ADMIN_BASIC_USER} {env.ADMIN_BASIC_HASH}
		}
		reverse_proxy api:8080 {
			transport http {
				read_timeout 180s
				response_header_timeout 180s
			}
		}
	}
	handle {
		reverse_proxy api:8080 {
			transport http {
				read_timeout 180s
				response_header_timeout 180s
			}
		}
	}
}

# 现役 App 基址（H2-only）。国内蜂窝直连 iPhone 11 不稳，开代理可通。
api.yiwanjia.work {
	tls {
		key_type rsa2048
	}
	import api_proxy
}

# 同机备用名，App 不再指向。
v1.yiwanjia.work {
	tls {
		key_type rsa2048
	}
	import api_proxy
}

# codedance 对照名（DNS 已指本机；H2-only）。用于 iPhone 11 直连对照，App Release 仍用 api.yiwanjia.work。
yizhidao.codedance.work {
	tls {
		key_type rsa2048
	}
	import api_proxy
}

yd.codedance.work {
	tls {
		key_type rsa2048
	}
	import api_proxy
}
