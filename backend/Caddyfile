# 国内遗留机（yzd.codedance.work）。H2-only。现役 App 不连此文件；新加坡用 Caddyfile.overseas。
{
	servers {
		protocols h1 h2
	}
}

yzd.codedance.work {
	encode gzip
	handle /download/* {
		root * /var/www/yizhidao
		file_server
	}
	handle {
		reverse_proxy api:8080 {
			transport http {
				read_timeout 180s
				response_header_timeout 180s
			}
		}
	}
}
