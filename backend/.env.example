# 复制为 .env 后修改
APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
SMS_COOLDOWN_SEC=60
SMS_CODE_EXPIRE_MIN=5
# 开发期固定验证码；留空则每次随机生成并在控制台打印
DEV_SMS_FIXED_CODE=123456
DATABASE_URL=sqlite:///./yizhidao.db
# mock：规则解读；openai：真实模型（OpenAI 兼容接口）
AI_MODE=mock

# 真实模型（AI_MODE=openai 时必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
