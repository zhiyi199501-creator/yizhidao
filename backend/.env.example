# 复制为 .env 后修改
APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
SMS_COOLDOWN_SEC=60
SMS_CODE_EXPIRE_MIN=5

# 短信通道：mock（本地打印）| tencent（腾讯云真实发送）
SMS_PROVIDER=mock
# mock 或 SMS_TEST_PHONES 白名单生效；留空则随机码并打印到控制台
DEV_SMS_FIXED_CODE=123456
# 测试账号（逗号分隔）：固定验证码、不发真实短信
SMS_TEST_PHONES=13800138000

# 腾讯云短信（SMS_PROVIDER=tencent 时必填）
# 控制台：https://console.cloud.tencent.com/smsv2
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 模板变量：code_and_minutes={验证码,分钟}；code_only={验证码}
TENCENT_SMS_TEMPLATE_PARAM_MODE=code_and_minutes

DATABASE_URL=sqlite:///./yizhidao.db

# mock：规则解读；openai：真实模型（OpenAI 兼容接口）
AI_MODE=mock

# 真实模型（AI_MODE=openai 时必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 经文路径（Docker 默认 /app/data/Hexagrams.json，一般不用改）
# HEXAGRAMS_PATH=
# 案例路径（未设时：data 卷 /app/data/cases.json → 镜像 /app/app/data/cases.json → 仓库 App 资源）
# CASES_PATH=

# 生产环境禁止固定验证码（除非显式打开，极不安全）
ALLOW_INSECURE_MOCK_SMS=false
