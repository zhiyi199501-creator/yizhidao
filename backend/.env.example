# 复制为 .env 后修改
APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
SMS_COOLDOWN_SEC=60
SMS_CODE_EXPIRE_MIN=5

# 短信通道：mock（本地打印）| tencent（腾讯云）| aliyun（阿里云号码认证，个人开发者友好）
SMS_PROVIDER=mock
# mock 或 SMS_TEST_PHONES 白名单生效；留空则随机码并打印到控制台
DEV_SMS_FIXED_CODE=123456
# 测试账号（逗号分隔）：固定验证码、不发真实短信
SMS_TEST_PHONES=13800138000

# 腾讯云短信（SMS_PROVIDER=tencent 时必填）
# 控制台：https://console.cloud.tencent.com/smsv2
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 模板变量：code_and_minutes={验证码,分钟}；code_only={验证码}
TENCENT_SMS_TEMPLATE_PARAM_MODE=code_and_minutes

# 阿里云号码认证短信（SMS_PROVIDER=aliyun 时必填，个人开发者可用赠送签名/模板）
# 控制台：https://dypns.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_SEC=300

DATABASE_URL=sqlite:///./yizhidao.db

# mock：规则解读；openai：走 OpenAI 兼容协议（不表示必须用 OpenAI）
AI_MODE=mock

# 真实模型（AI_MODE=openai 时必填）。BASE_URL / MODEL 以本文件为准。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# AI 限流（按登录用户；解读与追问共用次数；自然日 UTC+8）
# AI_RATE_INTERVAL_SEC=8
# AI_RATE_DAILY_LIMIT=40

# 经文路径（Docker 默认 /app/data/Hexagrams.json，一般不用改）
# HEXAGRAMS_PATH=
# 案例路径（未设时：data 卷 /app/data/cases.json → 镜像 /app/app/data/cases.json → 仓库 App 资源）
# CASES_PATH=
# 黄庭书院讲解（未设时：data 卷 → 镜像 /app/app/data/ImaExplanations.json → 仓库 App 资源）
# IMA_EXPLANATIONS_PATH=

# 生产环境禁止固定验证码（除非显式打开，极不安全）
ALLOW_INSECURE_MOCK_SMS=false

# Apple / Google OAuth（逗号分隔；Apple 默认 bundle id）
APPLE_CLIENT_IDS=com.yizhidao.app
GOOGLE_CLIENT_IDS=

# 邮箱验证码（改完须重启后端）
EMAIL_COOLDOWN_SEC=60
EMAIL_CODE_EXPIRE_MIN=5
EMAIL_PROVIDER=mock
# 有值：development+mock 下任意合法邮箱用此码；空：随机码，终端 [email:mock]
DEV_EMAIL_FIXED_CODE=123456
# smtp 下这些邮箱不发真信、只用固定码。审核/生产公网应留空
EMAIL_TEST_ADDRESSES=test@example.com
ALLOW_INSECURE_MOCK_EMAIL=false

# SMTP（EMAIL_PROVIDER=smtp 时必填）。Resend：host smtp.resend.com、port 587、user resend、password=API Key、USE_TLS=true（勿 465）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
